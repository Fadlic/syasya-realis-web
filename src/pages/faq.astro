---
import Base from "../layouts/Base.astro";
import { getContent, pageText, heading, para } from "../lib/content.mjs";
const F = pageText(await getContent(), "en").faq;
---
<Base title="FAQ — Syasya&Realis" page="faq" description="Working with Syasya&Realis: project cost, timelines, how to book, revisions, location shoots, file ownership and editing existing footage.">
<main id="faq">
  <section class="ab-hero">
    <div class="eyebrow mono"><span>(FAQ) <span data-name>Syasya&Realis</span></span><span>Questions</span></div>
    <h1 class="rv" set:html={heading(F.headline)} />
    <p class="lead rv" set:html={para(F.lead)} />
  </section>
  <section style="padding-top:0">
    <div class="faq-page rv">
      <div class="qa">
      {F.items.map((it) => (
        <details><summary>{it.q}<i aria-hidden="true">+</i></summary><div class="ans">{it.a}</div></details>
      ))}
    </div>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="ab-cta">
      <p class="rv">Didn't find <span class="serif">it?</span></p>
      <a class="btn fill" href="/#contact">Ask us directly
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11 11 3M5 3h6v6"/></svg></a>
    </div>
  </section>
</main>
</Base>
