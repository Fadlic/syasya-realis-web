---
import Base from "../layouts/Base.astro";
import { PHOTO_STEP } from "../data/archive.mjs";
import { getContent, pageText, heading, para, jsonForScript } from "../lib/content.mjs";
/* text and archive: published content from the admin panel over the built-in defaults */
const content = await getContent();
const T = pageText(content, "en").home;
const shown = (list) => list.filter((x) => !x.hidden);   // "Visible" off in the admin = not on the website
const WORK = shown(content.archive.film), PHOTOS = shown(content.archive.photos), DESIGN = shown(content.archive.design);
/* data for the browser scripts; "<" escaped so the JSON can never close the tag */
const archiveJson = jsonForScript({ work: WORK, photos: PHOTOS, design: DESIGN, photoStep: PHOTO_STEP });
const no = (i) => String(i + 1).padStart(2, "0");
const file = (p) => (p || "").split("/").pop();
---
<Base title="Syasya&Realis — Visual Narratives & Moving Art" page="index" intro>
<main id="top">
  <script type="application/json" id="archive-data" is:inline set:html={archiveJson}></script>
  <!-- HERO -->
  <section class="hero" style="padding:0">
    <div class="hero-media" id="heroMedia"></div>
    <div class="frame" aria-hidden="true"><i></i><i></i></div>
    <div class="hud mono" aria-hidden="true">
      <span class="rec"><i></i>REC · Showreel</span>
      <span class="tc" id="tc">00:00:00:00</span>
    </div>
    <div class="hero-inner">
      <h1>
        <span class="ln"><span set:html={heading(T.headline1)} /></span>
        <span class="ln"><span set:html={heading(T.headline2)} /></span>
      </h1>
      <div class="hero-row">
        <p class="cover-quote" set:html={para(T.quote)} />
        <div class="acts">
          <a class="btn fill v2-only" href="#contact">Start a project
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11 11 3M5 3h6v6"/></svg></a>
          <button class="play" id="playReel"><b><svg viewBox="0 0 16 16" fill="#0A0807"><path d="M4 2.5v11l9-5.5z"/></svg></b>Watch showreel</button>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <div class="clients-wrap" id="clientsWrap">
    <div class="clients-label mono v2-only">Four disciplines</div>
    <div class="clients" aria-label="Four disciplines">
      <div class="track" id="clientTrack"></div>
      <div class="track" id="clientTrack2" aria-hidden="true"></div>
    </div>
  </div>

  <section id="work" style="padding-top:0">
    <div class="eyebrow mono"><span>(01) Featured Archive</span><span>Film</span></div>
    <div class="work-head">
      <div><h2 class="h2 rv" set:html={heading(T.archiveHeading)} /><p class="lead rv archive-lead" set:html={para(T.archiveIntro)} /></div>
      <div class="filters" id="filters" role="group" aria-label="Filter work"></div>
      <nav class="arch-jump rv" aria-label="Archive sections"><a href="#work" class="on"><span class="mono">01</span>Film</a><a href="#photography"><span class="mono">02</span>Stills</a><a href="#design"><span class="mono">03</span>Design</a></nav>
    </div>
    <div class="grid" id="grid" hidden></div>
    <div class="proj" id="proj">
      <div class="proj-stick">
        <div class="beam" aria-hidden="true"></div><canvas class="dust" id="dust" aria-hidden="true"></canvas>
        <div class="proj-track" id="projTrack">{WORK.map((w, i) => (
          <div class="pf" tabindex="0" role="button" aria-label={`Play ${w.title}`}><span class="edge">S&amp;R 400 <b>▸ {no(i)}</b> {no(i)}A</span><div class="fr"><div class="ph" data-label={file(w.video)}></div><video muted loop playsinline preload="none" poster={w.poster || undefined}><source src={w.video} type="video/mp4"></video></div></div>
        ))}</div>
        <div class="proj-info"><span class="mono" id="projNo">01 / {String(WORK.length).padStart(2, "0")}</span><h3 id="projTitle"></h3><span class="mono" id="projCat"></span></div>
        <div class="proj-bar" aria-hidden="true"><i id="projBar"></i></div>
        <span class="proj-hint mono">Scroll to advance the reel</span>
      </div>
    </div>
  </section>


  <!-- PHOTOGRAPHY -->
  <section id="photography">
    <div class="eyebrow mono"><span>(01) Featured Archive</span><span>Stills</span></div>
    <div class="work-head">
      <h2 class="h2 rv" set:html={heading(T.stillsHeading)} />
      <p class="lead rv" style="max-width:36ch" set:html={para(T.stillsIntro)} />
    </div>
    <div class="gallery" id="gallery">{PHOTOS.slice(0, PHOTO_STEP).map((p) => (
      <div class="ph-item rv in" style={`--ar:${p.ar}`}><img alt={p.alt} loading="lazy" decoding="async" src={p.src}></div>
    ))}</div>
    <div class="more"><button class="btn" id="moreBtn">Show more photos</button></div>
  </section>

  <!-- DESIGN -->
  <section id="design" style="padding-top:0">
    <div class="eyebrow mono"><span>(01) Featured Archive</span><span>Design</span></div>
    <div class="work-head">
      <h2 class="h2 rv" set:html={heading(T.designHeading)} />
      <p class="lead rv" style="max-width:38ch" set:html={para(T.designIntro)} />
    </div>
    <div class="design-grid" id="designGrid">{DESIGN.map((d) => (
      <article class={`d-item rv ${d.size || ""}`} tabindex="0"><div class="shot" style={d.ar ? `--ar:${d.ar}` : undefined}><img alt={d.alt || d.title} loading="lazy" decoding="async" src={d.src}></div><div class="item-meta"><h3 style="font-size:17px">{d.title}</h3><span class="mono">{d.cat}</span></div></article>
    ))}</div>
  </section>

  <!-- MANIFESTO -->
  <section id="manifesto" class="manifesto">
    <div class="eyebrow mono"><span>(02) Manifesto</span><span>What we believe</span></div>
    <figure class="mf grade rv" id="grade"><canvas id="gradeRaw" aria-hidden="true"></canvas><canvas id="gradeFin" aria-hidden="true"></canvas><span class="gl l mono">Reality · RAW</span><span class="gl r mono">Imagination · GRADED</span><i class="gdiv" aria-hidden="true"></i>
      <blockquote><p set:html={heading(T.manifesto)} /></blockquote>
      <figcaption class="mono"><span data-name>Syasya&Realis</span></figcaption>
    </figure>
  </section>

  <!-- INTRO -->
  <section id="about">
    <div class="eyebrow mono"><span>(03) About</span><span>Syasya Ahmad</span></div>
    <div class="intro">
      <h2 class="h2 rv" set:html={heading(T.aboutHeading)} />
      <div class="rv">
        <p class="lead" set:html={para(T.aboutP1)} />
        <p class="lead about-p2" set:html={para(T.aboutP2)} />
        <a class="about-more" href="/about">More about the studio ↗</a>
        <div class="facts v2-only">
          <div><b>End-to-end</b><span>From brief and script to final delivery</span></div>
          <div><b>One team</b><span>Video, photo and design under one roof</span></div>
          <div><b>Every format</b><span>16:9, 9:16, 1:1 and 4:5 cut-downs</span></div>
          <div><b>4 disciplines</b><span>Photography, videography, montage and graphic design</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <!-- SERVICES -->
  <section id="services" style="padding-top:0">
    <div class="eyebrow mono"><span>(04) Services</span><span>Disciplines</span></div>
    <h2 class="h2 rv" style="margin-bottom:clamp(36px,7vh,72px)" set:html={heading(T.servicesHeading)} />
    <div class="services">
      <article class="svc rv">
        <span class="mono n">01 /</span>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="11" width="32" height="23" rx="3"/><path d="M14 11l3-5h6l3 5"/><circle cx="20" cy="22" r="6.5"/></svg>
        <h3>{T.services[0].title}</h3>
        <p set:html={para(T.services[0].text)} />
      </article>
      <article class="svc rv">
        <span class="mono n">02 /</span>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="12" width="23" height="17" rx="3"/><path d="M27 18l9-5v15l-9-5z"/><circle cx="10" cy="7" r="3"/><circle cx="20" cy="7" r="3"/></svg>
        <h3>{T.services[1].title}</h3>
        <p set:html={para(T.services[1].text)} />
      </article>
      <article class="svc rv">
        <span class="mono n">03 /</span>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 30h32M4 22h32M4 14h32"/><rect x="8" y="11" width="10" height="6" rx="1"/><rect x="20" y="19" width="12" height="6" rx="1"/><rect x="11" y="27" width="8" height="6" rx="1"/><path d="M24 6v28"/></svg>
        <h3>{T.services[2].title}</h3>
        <p set:html={para(T.services[2].text)} />
      </article>
      <article class="svc rv">
        <span class="mono n">04 /</span>
        <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 32l4-12L28 4l8 8-16 16z"/><path d="M12 20l8 8"/><circle cx="10" cy="30" r="1.5"/></svg>
        <h3>{T.services[3].title}</h3>
        <p set:html={para(T.services[3].text)} />
      </article>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" style="padding-top:0">
    <div class="eyebrow mono"><span>(04) Services</span><span>Process</span></div>
    <h2 class="h2 rv" set:html={heading(T.processHeading)} />
    <div class="steps" style="margin-top:clamp(40px,7vh,80px)">{T.steps.map((st, i) => (
      <div class="step rv"><span class="mono">Step 0{i + 1}</span><h4>{st.title}</h4><ul class="step-pts">{st.points.map((p) => <li>{p}</li>)}</ul></div>
    ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" style="padding-top:0">
    <div class="eyebrow mono"><span>(05) Colophon</span><span>Start a project</span></div>
    <div class="contact">
      <div>
        <p class="big rv" set:html={heading(T.contactHeading)} />
        <div class="reach">
          <button id="copyMail"><span class="ci"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7.5 12 13l8.5-5.5"/></svg></span><span class="lbl"><small>Email</small><span data-email>hello@studio.com</span></span></span><span class="mono ink-3" id="copyHint">Copy</span></button>
          <a href="#" data-ig target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)"><span class="ci"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></span><span class="lbl"><small>Instagram</small><span>See our latest work</span></span></span><span class="arr">↗</span></a>
          <a href="#" data-wa target="_blank" rel="noopener" aria-label="WhatsApp (opens in a new tab)"><span class="ci"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.7a8.6 8.6 0 0 1-12.7 7.6L3.5 20.5l1.3-4.1a8.6 8.6 0 1 1 15.7-4.7z"/><path d="M9.2 7.9c-.4 0-.9.5-.9 1.3 0 2.6 3.5 6.3 6.6 6.3.8 0 1.3-.6 1.3-1 0-.3-.1-.5-.4-.6l-1.6-.8c-.3-.1-.5 0-.7.2l-.5.6c-1-.4-2.2-1.6-2.6-2.6l.6-.5c.2-.2.3-.4.2-.7l-.7-1.7c-.1-.3-.4-.5-.7-.5z" fill="currentColor" stroke="none"/></svg></span><span class="lbl"><small>WhatsApp</small><span>Chat with us directly</span></span></span><span class="arr">↗</span></a>
        </div>
      </div>
      <form id="brief" novalidate>
        <div class="applied" id="applied" hidden></div>
        <input type="hidden" name="booking_code" id="booking-code">
        <input type="hidden" name="campaign_id" id="campaign-id">
        <div class="hp" aria-hidden="true"><label for="hp-website">Website</label><input id="hp-website" name="website" tabindex="-1" autocomplete="off"></div>
        <div class="f"><label class="mono" for="fn">Name</label><input id="fn" name="name" required autocomplete="name"></div>
        <div class="f"><label class="mono" for="fc">Company</label><input id="fc" name="company" autocomplete="organization"></div>
        <div class="f full"><span class="mono ink-3">What do you need?</span>
          <div class="chips" style="margin-top:6px">
            <input type="checkbox" id="s1" name="svc" value="Company profile video"><label for="s1">Company profile</label>
            <input type="checkbox" id="s2" name="svc" value="Marketing / business montage"><label for="s2">Marketing montage</label>
            <input type="checkbox" id="s3" name="svc" value="Product video"><label for="s3">Product video</label>
            <input type="checkbox" id="s4" name="svc" value="Videography"><label for="s4">Videography</label>
            <input type="checkbox" id="s5" name="svc" value="Photography"><label for="s5">Photography</label>
            <input type="checkbox" id="s6" name="svc" value="Editing & post-production"><label for="s6">Editing</label>
            <input type="checkbox" id="s7" name="svc" value="Social content"><label for="s7">Social content</label>
            <input type="checkbox" id="s8" name="svc" value="Graphic design"><label for="s8">Graphic design</label>
          </div>
        </div>
        <div class="f"><label class="mono" for="ft">Timeline</label>
          <select id="ft" name="timeline"><option>Flexible</option><option>Within 2 weeks</option><option>Within a month</option><option>1–3 months</option></select></div>
        <div class="f"><label class="mono" for="fe">Email</label><input id="fe" name="email" type="email" autocomplete="email"></div>
        <div class="f full"><label class="mono" for="fm">Project details</label><textarea id="fm" name="msg" placeholder="Tell us about the brand, the goal and where it will be published."></textarea></div>
        <div class="form-foot">
                    <span class="mono ink-3 v2-only">Your brief is filled in for you</span>
          <div class="send-row v2-only">
            <a class="btn wa" id="sendWa" href="#" target="_blank" rel="noopener">Send via WhatsApp
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11 11 3M5 3h6v6"/></svg></a>
            <a class="btn" id="sendMail" href="#">Send via email
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11 11 3M5 3h6v6"/></svg></a>
          </div>
          <span id="formNote" hidden></span>
          <p id="saveStatus" role="status" aria-live="polite"></p>
        </div>
        <div class="out" id="out">
          <span class="mono ink-3">Your brief — copy it and send to <span data-email>hello@studio.com</span></span>
          <pre id="outText"></pre>
          <button class="btn" type="button" id="copyBrief">Copy brief</button>
        </div>
      </form>
    </div>
  </section>
</main>
</Base>
