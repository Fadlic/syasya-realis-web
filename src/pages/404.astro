---
/* Shown by the host for any address that does not exist (wrangler.jsonc: not_found_handling = "404-page"). */
import Base from "../layouts/Base.astro";
import { t } from "../i18n/index.mjs";
const U = t("en").notfound;
---
<Base page="404" noindex>
<main id="notfound">
  <section class="ab-hero">
    <div class="eyebrow mono"><span>(404) <span data-name>Syasya&Realis</span></span><span>{U.eyebrow}</span></div>
    <h1 class="rv" set:html={U.heading} />
    <p class="lead rv" set:html={U.lead} />
    <p class="rv" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a class="btn fill" href="/">{U.home}</a><a class="btn" href="/#contact">{U.contact}</a></p>
  </section>
</main>
</Base>
