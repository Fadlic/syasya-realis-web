---
/* Shown by the host for any address that does not exist (wrangler.jsonc: not_found_handling = "404-page"). */
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Syasya&Realis" page="404" description="This page does not exist. Return to the Syasya&Realis homepage." noindex>
<main id="notfound">
  <section class="ab-hero">
    <div class="eyebrow mono"><span>(404) <span data-name>Syasya&Realis</span></span><span>Out of frame</span></div>
    <h1 class="rv">This frame <span class="serif">is empty.</span></h1>
    <p class="lead rv">The page you were looking for has moved or never existed. <em class="hl">Start again from the beginning</em> — or tell us what you were after.</p>
    <p class="rv" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a class="btn fill" href="/">Back to the homepage</a><a class="btn" href="/#contact">Contact the studio</a></p>
  </section>
</main>
</Base>
